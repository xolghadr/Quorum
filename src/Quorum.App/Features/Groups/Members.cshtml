@page "/members"
@model Quorum.App.Features.Groups.MembersModel
<h1>Members</h1>
@if (Model.Error is not null)
{
    <p>@Model.Error</p>
    <partial name="/Features/Shared/_Reference.cshtml" />
}
<ul>
    @foreach (var member in Model.Members)
    {
        <li>
            <span>@member.DisplayName</span>
            @if (Model.IsCreator)
            {
                <form method="post" asp-antiforgery="true" action="/members/@member.Id/rename">
                    <label>New name <input type="text" name="displayName" value="@member.DisplayName" /></label>
                    <button type="submit">Rename</button>
                </form>
                @if (!member.IsCreator)
                {
                    <form method="post" asp-antiforgery="true" action="/members/@member.Id/remove">
                        <button type="submit">Remove</button>
                    </form>
                }
            }
            else if (member.IsSelf)
            {
                <form method="post" asp-antiforgery="true" action="/members/leave">
                    <button type="submit">Leave</button>
                </form>
            }
        </li>
    }
</ul>
@if (Model.Pending.Count > 0)
{
    <h2>Pending invitations</h2>
    <ul>
        @foreach (var invitation in Model.Pending)
        {
            <li>
                <span>@invitation.Email</span>
                <form method="post" asp-antiforgery="true" action="/members/invitations/@invitation.Id/cancel">
                    <button type="submit">Cancel</button>
                </form>
            </li>
        }
    </ul>
}
<form method="post" asp-antiforgery="true" action="/members">
    <label>Email <input asp-for="Email" type="text" /></label>
    <button type="submit">Invite</button>
</form>
