@page "/groups/invitations/{invitationId:guid}/accept"
@model Quorum.App.Features.Groups.AcceptInvitationModel
<h1>Accept invitation</h1>
<p>@Model.GroupName</p>
<p>@Model.InviterDisplayName</p>
@if (Model.Error is not null)
{
    <p>@Model.Error</p>
    <partial name="/Features/Shared/_Reference.cshtml" />
}
<form method="post" asp-antiforgery="true">
    <label>Display name <input asp-for="DisplayName" type="text" /></label>
    <button type="submit">Accept</button>
</form>
